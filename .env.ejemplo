# Copiá a .env solo si necesitás algo. Sin nada, todo corre en local con PGlite y login simulado.
# PGLITE_DIR=.datos/pglite        # o "memoria" para no guardar nada
# DATABASE_URL=postgres://...     # Postgres propio (Docker/CI)
# DSQL_ENDPOINT=...               # Aurora DSQL (lo pone la tubería de Vadeo; necesita credenciales AWS)
