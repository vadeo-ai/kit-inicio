{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM"], "types": ["node"],
    "paths": { "@shared/*": ["./shared/*"], "@db/*": ["./db/*"], "@web/*": ["./web/src/*"] },
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["web/src", "api", "shared", "db", "pruebas", "scripts/*.ts", "web/vite.config.ts", "vitest.config.ts"]
}
