{
  "name": "kit-inicio",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch api/local.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "migrar": "tsx scripts/migrar.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:sql": "node scripts/lint-sql-dsql.mjs",
    "build": "vite build --config web/vite.config.ts && node scripts/empaquetar-api.mjs",
    "verificar": "npm run lint:sql && npm run lint:funciones && npm run lint:bitacora && npm run typecheck && npm test",
    "lint:bitacora": "node scripts/revisar-bitacora.mjs",
    "lint:funciones": "node scripts/revisar-funciones.mjs"
  },
  "dependencies": {
    "@aws-sdk/dsql-signer": "^3.1156.0",
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "license": "Apache-2.0"
}
